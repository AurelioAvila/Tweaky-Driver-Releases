    <docsUrl>https://pctweaker.app/tweaky-driver/</docsUrl>
    <bugTrackerUrl>https://github.com/AurelioAvila/Tweaky-Driver-Releases/issues</bugTrackerUrl>
    <dependencies>
      <dependency id="webview2-runtime" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\*.ps1" target="tools" />
  </files>
</package>
